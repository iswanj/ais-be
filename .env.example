# Copy to .env for local development. Keep real credentials out of Git.
AISSTREAM_API_KEY=replace-with-your-aisstream-key
# AISstream corners are [latitude,longitude]: northwest, then southeast.
AIS_BOUNDING_BOXES=[[[25.835,-80.208],[25.603,-79.879]]]
# Use the Supabase Session pooler URL (port 5432) on Render.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PORT=3000
