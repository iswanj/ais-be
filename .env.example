# Copy to .env for local development. Keep real credentials out of Git.
AISSTREAM_API_KEY=replace-with-your-aisstream-key
# Corners are [latitude,longitude]: northwest, then southeast. This box is the whole world.
AIS_BOUNDING_BOXES=[[[90,-180],[-90,180]]]
# Use the Supabase Session pooler URL (port 5432) on Render.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PORT=3000
