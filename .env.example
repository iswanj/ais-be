# Copy to .env for local development. Keep real credentials out of Git.
AISSTREAM_API_KEY=replace-with-your-aisstream-key
# Startup coverage only. Corners are [latitude,longitude]: northwest, then southeast.
# After map requests, the stream follows the three most recent viewports on one connection.
# Singapore Harbor, Tuas to the west, and the Eastern Anchorage near Changi.
AIS_BOUNDING_BOXES=[[[1.270,103.720],[1.200,103.880]],[[1.300,103.580],[1.210,103.720]],[[1.350,103.900],[1.250,104.080]]]
# Use the Supabase Session pooler URL (port 5432) on Render.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PORT=3000
